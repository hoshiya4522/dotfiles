#!/bin/bash

DIR="$HOME/.config/self/journal"
EXT="txt"

# Default to +0 for today so it cleanly matches the offset logic
INPUT=${1:-+0}

CURRENT_YEAR=$(date +%Y)
CURRENT_MONTH=$(date +%m)

# Resolve last day of current month
LAST_DAY=$(date -d "$CURRENT_YEAR-$CURRENT_MONTH-01 +1 month -1 day" +%d)

TARGET_DATE=""

# 1. YYYY-MM-DD
if [[ "$INPUT" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
    TARGET_DATE="$INPUT"

# 2. Day offset (+N or -N)
elif [[ "$INPUT" =~ ^[+-][0-9]+$ ]]; then
    TARGET_DATE=$(date -d "$INPUT day" +%F)

# 3. Day of month (Raw numbers without signs)
elif [[ "$INPUT" =~ ^[0-9]+$ ]]; then
    if [ "$INPUT" -ge 1 ] && [ "$INPUT" -le "$LAST_DAY" ]; then
        TARGET_DATE=$(date -d "$CURRENT_YEAR-$CURRENT_MONTH-$INPUT" +%F)
    else
        echo "Invalid day for current month: $INPUT (max is $LAST_DAY)"
        exit 1
    fi

else
    echo "Invalid input: $INPUT"
    echo "Use:"
    echo "  jn            (today)"
    echo "  jn <+N/-N>    (day offset, e.g. -1, +2)"
    echo "  jn YYYY-MM-DD (specific date)"
    echo "  jn <1-31>     (day of current month)"
    exit 1
fi

FILE="$DIR/$TARGET_DATE.$EXT"

nvim "$FILE"
