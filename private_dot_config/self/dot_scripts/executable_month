#!/bin/bash

CALENDAR="$HOME/.config/self/calendar-$(date +%Y).txt"

OFFSET=${1:-0}
TODAY=$(date +%F)

# Target month (YYYY-MM)
TARGET_MONTH=$(date -d "$OFFSET month" +%Y-%m)

awk -v month="$TARGET_MONTH" -v today="$TODAY" '
substr($1,1,7) == month {
    if ($1 == today) {
        # Bold + yellow text for today
        print "\033[1;33m" $0 "\033[0m"
    } else {
        print $0
    }
}
' "$CALENDAR"
